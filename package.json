
{
  "name": "texforever",
  "version": "1.0.0",
  "description": "TEXFOREVER - Web Application",
  "private": true,
  "homepage": "./",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win nsis --publish never",
    "build-windows": "electron-builder --win --publish never",
    "build-windows-installer": "electron-builder --win --publish never",
    "build-android": "cordova build android",
    "build-android-release": "cordova build android --release",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.kumar.texforever",
    "productName": "TEXFOREVER",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!android/**",
      "!www/**",
      "!dist/**",
      "!.git/**",
      "!.github/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon-512.ico",
      "artifactName": "TEXFOREVER Setup.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TEXFOREVER",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "cordova": "^13.0.0"
  }
}
